{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vinext": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:vinext": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start:vinext": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build -- --webpack && node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "verify:v04-schema": "node --import tsx scripts/verify-v04-schema.ts",
    "verify:v04-workflow": "node --import tsx scripts/verify-v04-workflow.ts",
    "verify:v04-preview": "node --import tsx scripts/verify-v04-migration-preview.ts",
    "verify:v04-schema-apply": "node --import tsx scripts/verify-v04-schema-apply.ts",
    "verify:v04-admin-bootstrap": "node --import tsx scripts/verify-v04-system-admin-bootstrap.ts",
    "verify:legacy-schema-compat": "node --import tsx scripts/verify-legacy-schema-compat.ts",
    "local:setup": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/setup-local-demo.ts",
    "local:dev": "next dev",
    "verify:v03-local": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/verify-v03-local.ts",
    "verify:v031-local": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/verify-v031-local.ts",
    "verify:v032-local": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/verify-v032-local.ts",
    "verify:v033-test": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/v033-test-fixture.ts verify",
    "verify:v034-test": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/verify-v034-shared-collaboration.ts",
    "fixture:v033:prepare": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/v033-test-fixture.ts prepare",
    "fixture:v033:cleanup": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/v033-test-fixture.ts cleanup",
    "audit:v033:origins": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/audit-v033-origins.ts",
    "verify:welcome-home-operation": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/verify-welcome-home-production-operation.ts",
    "verify:v02-v03-batch": "NODE_ENV=development node --env-file=.env.local --import tsx scripts/verify-v02-v03-batch-operation.ts",
    "thumbnails:backfill": "tsx scripts/backfill-thumbnails.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.12",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module"
}
