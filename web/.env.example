# Supabase Postgres connection string for the server runtime.
# Use the pooled postgres/owner connection for hosted/serverless deployments; do not use the Supabase anon key.
DATABASE_URL=postgresql://postgres.example:password@aws-0-region.pooler.supabase.com:6543/postgres

# Leave enabled for Supabase unless you are connecting to a local Postgres.
SUPABASE_DB_SSL=true
DATABASE_POOL_MAX=5
POSTGRES_CONNECTION_TIMEOUT_MS=8000

# Production app URL and WeCom OAuth.
APP_URL=https://hamark.boga.plus
AUTH_SECRET=replace-with-at-least-32-random-bytes-base64
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_AGENT_ID=1000002
WECOM_PROXY_URL=https://hamark-wecom.boga.plus
WECOM_PROXY_SECRET=replace-with-at-least-32-random-bytes-base64

# Local direct mode only. Production uses the fixed IP proxy above.
# WECOM_SECRET=replace-with-wecom-app-secret

# Tencent Cloud COS private bucket.
COS_REGION=ap-guangzhou
COS_BUCKET=hamark-videos-1250000000
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults to https://cos.${COS_REGION}.myqcloud.com
# COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com

# 录音点评改写（docs/25 4.7）。入口只对老孙出现，且要 DeepSeek 密钥和 COS 齐全（或走 fake）。
# 必填：DeepSeek 密钥。调用会产生费用。
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：模型与地址，默认 deepseek-flash / https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：腾讯云录音文件识别的子账号密钥；两个都不配就复用 COS_SECRET_ID / COS_SECRET_KEY。
# 该子账号需要 ASR 的 CreateRecTask、DescribeTaskStatus 权限，以及 COS 路径 audio-reviews/* 的读写。
# TENCENT_ASR_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TENCENT_ASR_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：识别引擎，默认 16k_zh_en_2.0（大模型 2.0，支持说话人分离）。
# TENCENT_ASR_ENGINE=16k_zh_en_2.0
# 可选：fake 走本地假实现（不联网、不收费，约 10 秒走完）；本机演示模式下不写就是 fake。
# AUDIO_REVIEW_PROVIDER=fake

# Optional, development-only self-contained demo mode. Never enable in production.
# LOCAL_DEMO_MODE=1
# APP_URL=http://localhost:3000
# DATABASE_URL=postgresql://postgres:hamark-local-demo@127.0.0.1:55432/hamark
# SUPABASE_DB_SSL=false
